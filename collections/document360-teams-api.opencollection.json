{
  "opencollection": "1.0.0",
  "info": {
    "name": "Document360 Articles Teams API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_token",
      "value": "{{api_token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Teams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Teams",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apihub.document360.io/v2/Teams"
          },
          "docs": "Retrieves teams in the knowledge base."
        }
      ]
    }
  ],
  "bundled": true
}